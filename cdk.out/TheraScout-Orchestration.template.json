  "TheraScoutPipelineDEF6CA5E": {
   "Type": "AWS::StepFunctions::StateMachine",
   "Properties": {
    "DefinitionString": {
     "Fn::Join": [
      "",
      [
       "{\n  \"Comment\": \"TheraScout pipeline. Each state below corresponds directly to a box in the agent pipeline diagram: Ingest -> Choice -> (Analyze in parallel | Enrich then Analyze) -> GapScore -> Report.\",\n  \"StartAt\": \"Agent_Ingest_CheckDataScope\",\n  \"States\": {\n    \"Agent_Ingest_CheckDataScope\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Diagram box: Agent: ingest â€” uses the check_data_scope tool\",\n      \"Resource\": \"",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttcheckdatascope218F1612Arn161C1C9A"
       },
       "\",\n      \"ResultPath\": \"$.scope_check\",\n      \"Next\": \"PublicDataSufficient\",\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\n            \"Lambda.ServiceException\",\n            \"Lambda.AWSLambdaException\",\n            \"Lambda.SdkClientException\",\n            \"Lambda.TooManyRequestsException\"\n          ],\n          \"IntervalSeconds\": 2,\n          \"MaxAttempts\": 3,\n          \"BackoffRate\": 2\n        }\n      ]\n    },\n    \"PublicDataSufficient\": {\n      \"Type\": \"Choice\",\n      \"Comment\": \"Diagram diamond: Public data sufficient?\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.scope_check.sufficient\",\n          \"BooleanEquals\": true,\n          \"Next\": \"Agent_Analyze_Parallel\"\n        }\n      ],\n      \"Default\": \"Agent_Enrich_EnterpriseData\"\n    },\n    \"Agent_Enrich_EnterpriseData\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Diagram box: Agent: enrich -> AgentCore Gateway -> Enterprise Data Store (MOCKED). Loops back into Analyze once enriched.\",\n      \"Resource\": \"",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttenrichenterprisedata41320ADAArn18C9D53B"
       },
       "\",\n      \"ResultPath\": \"$.enrichment\",\n      \"Next\": \"Agent_Analyze_Parallel\",\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\n            \"Lambda.ServiceException\",\n            \"Lambda.AWSLambdaException\",\n            \"Lambda.SdkClientException\",\n            \"Lambda.TooManyRequestsException\"\n          ],\n          \"IntervalSeconds\": 2,\n          \"MaxAttempts\": 3,\n          \"BackoffRate\": 2\n        }\n      ]\n    },\n    \"Agent_Analyze_Parallel\": {\n      \"Type\": \"Parallel\",\n      \"Comment\": \"Diagram box: Agent: analyze â€” the broadcast/gather fan-out to all 6 specialist agents, run in parallel. MVP NOTE: each branch below currently calls its data-fetch tool directly (Milestone 1-3 of the build order). Once a branch's real AgentCore agent is built, swap its Resource to the invoke_agentcore_agent Lambda (see Agent_GapAnalysisAndScoring below for that pattern) so the agent can reason over the fetched data rather than just returning it raw.\",\n      \"ResultPath\": \"$.agent_findings\",\n      \"Branches\": [\n        {\n          \"StartAt\": \"DiseaseAgent\",\n          \"States\": {\n            \"DiseaseAgent\": {\n              \"Type\": \"Task\",\n              \"Resource\": \"",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttqueryglobocandata5C4D6A01ArnE2990389"
       },
       "\",\n              \"End\": true,\n              \"Retry\": [\n                {\n                  \"ErrorEquals\": [\n                    \"Lambda.ServiceException\",\n                    \"Lambda.AWSLambdaException\",\n                    \"Lambda.SdkClientException\",\n                    \"Lambda.TooManyRequestsException\"\n                  ],\n                  \"IntervalSeconds\": 2,\n                  \"MaxAttempts\": 3,\n                  \"BackoffRate\": 2\n                }\n              ]\n            }\n          }\n        },\n        {\n          \"StartAt\": \"TreatmentAgent\",\n          \"States\": {\n            \"TreatmentAgent\": {\n              \"Type\": \"Task\",\n              \"Resource\": \"",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttqueryopenfdaDA8C78AEArn10D103B5"
       },
       "\",\n              \"End\": true,\n              \"Retry\": [\n                {\n                  \"ErrorEquals\": [\n                    \"Lambda.ServiceException\",\n                    \"Lambda.AWSLambdaException\",\n                    \"Lambda.SdkClientException\",\n                    \"Lambda.TooManyRequestsException\"\n                  ],\n                  \"IntervalSeconds\": 2,\n                  \"MaxAttempts\": 3,\n                  \"BackoffRate\": 2\n                }\n              ]\n            }\n          }\n        },\n        {\n          \"StartAt\": \"ResearchAgent\",\n          \"States\": {\n            \"ResearchAgent\": {\n              \"Type\": \"Task\",\n              \"Resource\": \"",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttquerypubmedA6734303Arn2728423C"
       },
       "\",\n              \"End\": true,\n              \"Retry\": [\n                {\n                  \"ErrorEquals\": [\n                    \"Lambda.ServiceException\",\n                    \"Lambda.AWSLambdaException\",\n                    \"Lambda.SdkClientException\",\n                    \"Lambda.TooManyRequestsException\"\n                  ],\n                  \"IntervalSeconds\": 2,\n                  \"MaxAttempts\": 3,\n                  \"BackoffRate\": 2\n                }\n              ]\n            }\n          }\n        },\n        {\n          \"StartAt\": \"ClinicalTrialAgent\",\n          \"States\": {\n            \"ClinicalTrialAgent\": {\n              \"Type\": \"Task\",\n              \"Resource\": \"",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttqueryclinicaltrialsD13471DEArn4DBED974"
       },
       "\",\n              \"End\": true,\n              \"Retry\": [\n                {\n                  \"ErrorEquals\": [\n                    \"Lambda.ServiceException\",\n                    \"Lambda.AWSLambdaException\",\n                    \"Lambda.SdkClientException\",\n                    \"Lambda.TooManyRequestsException\"\n                  ],\n                  \"IntervalSeconds\": 2,\n                  \"MaxAttempts\": 3,\n                  \"BackoffRate\": 2\n                }\n              ]\n            }\n          }\n        },\n        {\n          \"StartAt\": \"CompetitionAgent\",\n          \"States\": {\n            \"CompetitionAgent\": {\n              \"Type\": \"Task\",\n              \"Comment\": \"MVP: derived from ClinicalTrials.gov sponsor field; a dedicated tool can be split out later\",\n              \"Resource\": \"",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttqueryclinicaltrialsD13471DEArn4DBED974"
       },
       "\",\n              \"End\": true,\n              \"Retry\": [\n                {\n                  \"ErrorEquals\": [\n                    \"Lambda.ServiceException\",\n                    \"Lambda.AWSLambdaException\",\n                    \"Lambda.SdkClientException\",\n                    \"Lambda.TooManyRequestsException\"\n                  ],\n                  \"IntervalSeconds\": 2,\n                  \"MaxAttempts\": 3,\n                  \"BackoffRate\": 2\n                }\n              ]\n            }\n          }\n        },\n        {\n          \"StartAt\": \"TrendAgent\",\n          \"States\": {\n            \"TrendAgent\": {\n              \"Type\": \"Task\",\n              \"Comment\": \"MVP: derived from PubMed publication-date trends; a dedicated tool can be split out later\",\n              \"Resource\": \"",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttquerypubmedA6734303Arn2728423C"
       },
       "\",\n              \"End\": true,\n              \"Retry\": [\n                {\n                  \"ErrorEquals\": [\n                    \"Lambda.ServiceException\",\n                    \"Lambda.AWSLambdaException\",\n                    \"Lambda.SdkClientException\",\n                    \"Lambda.TooManyRequestsException\"\n                  ],\n                  \"IntervalSeconds\": 2,\n                  \"MaxAttempts\": 3,\n                  \"BackoffRate\": 2\n                }\n              ]\n            }\n          }\n        }\n      ],\n      \"Next\": \"Agent_GapAnalysisAndScoring\"\n    },\n    \"Agent_GapAnalysisAndScoring\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Diagram box: Agent: gap_score â€” combines all 6 findings, applies data/scoring_weights.json, ranks Top 5-6. TEMPORARILY using the Bedrock-free deterministic fallback scorer because bedrock:InvokeModel is denied by the org SCP. To restore real agent reasoning, swap Resource back to ",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttinvokeagentcoreagent3D525339ArnDBB8D1A8"
       },
       " and restore Parameters with agent_runtime_id=gap_scoring_agent, session_id.$=$$.Execution.Name, payload.$=$.agent_findings, and drop InputPath.\",\n      \"Resource\": \"",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttscoreopportunitiesfallback839A520EArn6D4C7055"
       },
       "\",\n      \"InputPath\": \"$.agent_findings\",\n      \"ResultPath\": \"$.ranked_opportunities\",\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\n            \"Lambda.ServiceException\",\n            \"Lambda.AWSLambdaException\",\n            \"Lambda.SdkClientException\",\n            \"Lambda.TooManyRequestsException\"\n          ],\n          \"IntervalSeconds\": 2,\n          \"MaxAttempts\": 3,\n          \"BackoffRate\": 2\n        }\n      ],\n      \"Next\": \"Agent_Report_ComposePdf\"\n    },\n    \"Agent_Report_ComposePdf\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Diagram box: Agent: report â€” Report Composer (ReportLab)\",\n      \"Resource\": \"",
       {
        "Fn::ImportValue": "TheraScout-Agents:ExportsOutputFnGetAttcomposepdfreport136B7298ArnEF0C3B8C"
       },
       "\",\n      \"ResultPath\": \"$.report\",\n      \"End\": true,\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\n            \"Lambda.ServiceException\",\n            \"Lambda.AWSLambdaException\",\n            \"Lambda.SdkClientException\",\n            \"Lambda.TooManyRequestsException\"\n          ],\n          \"IntervalSeconds\": 2,\n          \"MaxAttempts\": 3,\n          \"BackoffRate\": 2\n        }\n      ]\n    }\n  }\n}\n"
      ]
     ]
    },
    "RoleArn": {
     "Fn::GetAtt": [
      "TheraScoutPipelineRoleF2752622",
      "Arn"
     ]
    },
    "StateMachineName": "TheraScoutOpportunityScan"
   },
   "DependsOn": [
    "TheraScoutPipelineRoleDefaultPolicy43AFA432",
    "TheraScoutPipelineRoleF2752622"
   ],
   "UpdateReplacePolicy": "Delete",
   "DeletionPolicy": "Delete",
   "Metadata": {
    "aws:cdk:path": "TheraScout-Orchestration/TheraScoutPipeline/Resource"
   }
