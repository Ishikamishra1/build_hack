  "StartScanApi87EF1867": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\nimport json, os, uuid, boto3\n\nsfn = boto3.client(\"stepfunctions\")\n\ndef lambda_handler(event, context):\n    body = json.loads(event.get(\"body\") or \"{}\")\n    therapeutic_area = body.get(\"therapeutic_area\", \"Colorectal Cancer\")\n\n    response = sfn.start_execution(\n        stateMachineArn=os.environ[\"STATE_MACHINE_ARN\"],\n        name=f\"scan-{uuid.uuid4()}\",\n        input=json.dumps({\"therapeutic_area\": therapeutic_area}),\n    )\n    return {\n        \"statusCode\": 202,\n        \"headers\": {\"Content-Type\": \"application/json\"},\n        \"body\": json.dumps({\"executionArn\": response[\"executionArn\"]}),\n    }\n"
    },
    "Environment": {
     "Variables": {
      "STATE_MACHINE_ARN": {
       "Ref": "TheraScoutPipelineDEF6CA5E"
      }
     }
    },
    "FunctionName": "therascout-start-scan",
    "Handler": "handler.lambda_handler",
    "Role": {
     "Fn::GetAtt": [
      "StartScanApiServiceRole24BD2031",
      "Arn"
     ]
    },
    "Runtime": "python3.12",
    "Timeout": 10
   },
   "DependsOn": [
    "StartScanApiServiceRoleDefaultPolicy8942FEFB",
    "StartScanApiServiceRole24BD2031"
   ],
   "Metadata": {
